{{!
    @template local_recertify/status

    Recertification status of each learner in a course: an expiry timeline (decorative; the table and the filter
    sentence carry the same facts in text), then every learner, most urgent first.

    Example context (json):
    {
        "enabled": true,
        "periodtext": "Certifications last 365 days. Reminders go out 30 and 7 days before.",
        "tiles": [{"key": "valid", "label": "Valid", "count": 12, "tone": "success", "url": "#", "active": false},
                  {"key": "expiring", "label": "Expiring soon", "count": 3, "tone": "warning", "url": "#", "active": false}],
        "nextweek": "One learner will be reset in the next 7 days.",
        "haspoints": true, "expiredzone": 12, "windowwidth": 7.2, "windowdays": 30, "periodend": "In 365 days",
        "points": [{"pos": 6, "tone": "danger", "label": "Eli Novak", "lane": 0},
                   {"pos": 13, "tone": "warning", "label": "Dana Ruiz, 8 November 2026", "lane": 0}],
        "hasdue": true,
        "filtered": false,
        "allurl": "#",
        "hasrows": true,
        "rows": [{"name": "Omar Haddad", "picture": "", "statekey": "expiring", "state": "Expiring soon",
                  "badge": "badge bg-warning text-dark", "completed": "3 December 2025", "expires": "3 December 2026",
                  "expiresin": "In 28 days", "past": 1}]
    }
}}
<div class="local-recertify">
    {{^enabled}}
    <div class="alert alert-info" role="status">
        <strong>{{#str}}notenabled, local_recertify{{/str}}</strong>
        <div>{{nextweek}}</div>
    </div>
    {{/enabled}}
    <p class="local-recertify-period" data-region="period">{{periodtext}}{{#enabled}}{{^hasdue}} {{nextweek}}{{/hasdue}}{{/enabled}}</p>
    {{#hasdue}}<p class="local-recertify-due" role="status">{{#pix}}i/warning, core{{/pix}}{{nextweek}}</p>{{/hasdue}}

    {{#haspoints}}
    <figure class="local-recertify-timeline" aria-hidden="true">
        <div class="local-recertify-track" style="--expired: {{expiredzone}}%; --window: {{windowwidth}}%">
            <span class="local-recertify-zone-expired"></span>
            <span class="local-recertify-zone-window"></span>
            <span class="local-recertify-today"><span>{{#str}}rel:today, local_recertify{{/str}}{{#windowdays}} · {{#str}}reminderwindow, local_recertify, {{windowdays}}{{/str}}{{/windowdays}}</span></span>
            {{#points}}
            <span class="local-recertify-dot tone-{{tone}}" style="left: {{pos}}%; --lane: {{lane}}" title="{{label}}"></span>
            {{/points}}
        </div>
        <div class="local-recertify-axis" style="--expired: {{expiredzone}}%; --window: {{windowwidth}}%">
            <span class="is-expired">{{#str}}tile:expired, local_recertify{{/str}}</span>
            <span class="is-end">{{periodend}}</span>
        </div>
    </figure>
    {{/haspoints}}

    <p class="local-recertify-filters">
        {{#tiles}}
        <a class="local-recertify-filter tone-{{tone}}{{#active}} active{{/active}}" href="{{url}}"{{#active}} aria-current="true"{{/active}}><strong>{{count}}</strong> {{label}}</a>
        {{/tiles}}
    </p>
    {{#filtered}}<p><a href="{{allurl}}">{{#str}}showall, local_recertify{{/str}}</a></p>{{/filtered}}

    {{#hasrows}}
    <div class="table-responsive">
        <table class="table generaltable table-hover local-recertify-status mb-0">
            <thead>
                <tr>
                    <th scope="col">{{#str}}learner, local_recertify{{/str}}</th>
                    <th scope="col">{{#str}}status, local_recertify{{/str}}</th>
                    <th scope="col">{{#str}}completed, local_recertify{{/str}}</th>
                    <th scope="col">{{#str}}expires, local_recertify{{/str}}</th>
                    <th scope="col" class="text-end">{{#str}}past, local_recertify{{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#rows}}
                <tr data-state="{{statekey}}">
                    <td><div class="d-flex align-items-center">{{{picture}}}<span class="ms-2">{{name}}</span></div></td>
                    <td><span class="{{badge}}">{{state}}</span></td>
                    <td>{{completed}}{{^completed}}<span class="text-muted">&ndash;</span>{{/completed}}</td>
                    <td>
                        {{#expires}}{{expires}}<div class="small text-muted">{{expiresin}}</div>{{/expires}}
                        {{^expires}}<span class="text-muted">&ndash;</span>{{/expires}}
                    </td>
                    <td class="text-end">{{past}}</td>
                </tr>
                {{/rows}}
            </tbody>
        </table>
    </div>
    {{/hasrows}}
    {{^hasrows}}<p class="text-muted border rounded text-center py-4">{{#str}}nolearners, local_recertify{{/str}}</p>{{/hasrows}}
</div>
